# Maps of chapters 2-6 (경주 순례). Each is 120 x 90 tiles like 서라벌 and is generated by World._paint_spec.
# zone: id, name, rect, music, amb, h (ground height in metres), dark (0 day .. 1 night), cp (respawn tile), safe (no yokai),
#       scatter [[prop kind, chance per cell], ...]
# areas paint terrain (World enum: SEA 0, SAND 1, GRASS 2, PATH 3, PLAZA 4, FOREST 5, POND 6, RUIN 7, YARD 8)
class_name Maps
extends RefCounted

const NAMES := {"seorabeol": "서라벌", "namsan": "남산", "toham": "토함산", "donghae": "동해 감은사", "hwangnyong": "황룡사", "banwol": "반월성"}
const ORDER := ["seorabeol", "namsan", "toham", "donghae", "hwangnyong", "banwol"]
# where the post-station keeper stands and where travellers arrive (tiles)
const STATION := {
	"seorabeol": {"mabu": [70, 63.6], "entry": [68, 62.6]},
	"namsan": {"mabu": [101, 72.5], "entry": [99, 74]},
	"toham": {"mabu": [100, 78.5], "entry": [98, 80]},
	"donghae": {"mabu": [24, 70.5], "entry": [26, 72]},
	"hwangnyong": {"mabu": [99, 66.5], "entry": [97, 68]},
	"banwol": {"mabu": [24, 76.5], "entry": [26, 78]},
}

static func get_spec(id: String) -> Dictionary:
	match id:
		"namsan": return namsan()
		"toham": return toham()
		"donghae": return donghae()
		"hwangnyong": return hwangnyong()
		"banwol": return banwol()
	return {}

static func lamps(list: Array) -> Array:
	var out = []
	for p in list: out.append(["lamppost", p[0], p[1]])
	return out


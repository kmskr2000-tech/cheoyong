; Engine configuration file.
config_version=5

[application]
config/name="신 처용가"
config/description="탈과 노래 — 2.5D 액션 RPG"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[autoload]
G="*res://scripts/g.gd"
Assets="*res://scripts/assets.gd"
Sfx="*res://scripts/audio.gd"
Inp="*res://scripts/input.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/window_width_override=1280
window/size/window_height_override=640

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.1, 1)

[importer_defaults]
texture={
"mipmaps/generate": true
}
